# Copy to gateway.env (gitignored) and pass as: phala deploy -e gateway.env
# Compose interpolates these into the measured manifest as variable
# references. Do not put plaintext secrets in compose.yaml.

# Audited Dstack-TEE/private-ai-gateway.git revision (full 40-hex SHA).
PRIVATE_AI_GATEWAY_REPO_COMMIT=3e56bd30dd459d0df90afeb6d63eca7a919bc22f

# Bearer token for GET/PUT /v1/admin/upstreams. Generate with: openssl rand -hex 32
PRIVATE_AI_GATEWAY_ADMIN_TOKEN=<long-random-admin-token>

# Default ACI-service upstream (api.redpill.ai).
REDPILL_API_KEY=<redpill-api-key>
REDPILL_MODEL1=nvidia/nemotron-3.5-lightning
REDPILL_MODEL2=z-ai/glm-5.3
REDPILL_MODEL3=qwen/qwen3.8-27b
REDPILL_MODEL4=meta/muse-glimmer-30b
REDPILL_MODEL5=deepseek/deepseek-v4-flash-0731
REDPILL_MODEL6=z-ai/glm-5.3-flash

# Default openai-compatible upstream (openrouter.ai).
OPENROUTER_API_KEY=<openrouter-api-key>
OPENROUTER_FREE_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FREE_MODEL1=poolside/laguna-s-2.1:free
OPENROUTER_FREE_MODEL2=poolside/laguna-m.1:free
OPENROUTER_FREE_MODEL4=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FREE_MODEL5=cohere/north-mini-code:free
OPENROUTER_FREE_MODEL6=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_GROK=x-ai/grok-4.1-fast
OPENROUTER_DEEP=deepseek/deepseek-v3.2
OPENROUTER_KIMILATEST=moonshotai/kimi-latest

# Solana SVM settlement (consumed by clawd-tee-gateway, not this binary).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
REDPILL_PROGRAM_ID=BnoUSPTE88ebzLb74RAnTogddDMzyBPtkmKxiRoRJG4L
