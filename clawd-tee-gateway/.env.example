# clawd-tee-gateway — copy to .env (gitignored)
# Solana SVM settles TeeProofV2 PDAs. This process is the Relay.

# Default ACI-service upstream
UPSTREAM_URL=https://api.redpill.ai
UPSTREAM_API_KEY=
UPSTREAM_PROVIDER=redpill
REDPILL_API_KEY=
REDPILL_MODEL1=nvidia/nemotron-3.5-lightning
REDPILL_MODEL2=z-ai/glm-5.3
REDPILL_MODEL3=qwen/qwen3.8-27b
REDPILL_MODEL4=meta/muse-glimmer-30b
REDPILL_MODEL5=deepseek/deepseek-v4-flash-0731
REDPILL_MODEL6=z-ai/glm-5.3-flash

# OpenRouter (openai-compatible). Switch with:
# UPSTREAM_URL=https://openrouter.ai/api  UPSTREAM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FREE_MODEL1=poolside/laguna-s-2.1:free
OPENROUTER_FREE_MODEL2=poolside/laguna-m.1:free
OPENROUTER_FREE_MODEL4=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FREE_MODEL5=cohere/north-mini-code:free
OPENROUTER_FREE_MODEL6=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_GROK=x-ai/grok-4.1-fast
OPENROUTER_DEEP=deepseek/deepseek-v3.2
OPENROUTER_KIMILATEST=moonshotai/kimi-latest

ALLOW_CLIENT_AUTHORIZATION=false
ALLOW_INSECURE_UPSTREAM=false

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
REDPILL_PROGRAM_ID=BnoUSPTE88ebzLb74RAnTogddDMzyBPtkmKxiRoRJG4L
SOLANA_KEYPAIR_PATH=
SOLANA_KEYPAIR_JSON=

NVIDIA_API_KEY=
NRAS_URL=https://nras.attestation.nvidia.com/v4/attest/gpu
SIGNING_KEY_PEM_PATH=
SIGNING_KEY_PEM=

PROOF_TTL_SECS=86400
VERIFICATION_LEVEL=0
SAS_PROOF_THRESHOLD=0

# Railway injects PORT; leave unset on Railway. Local default 8080.
PORT=8080
BIND_ADDR=0.0.0.0
RUST_LOG=info,clawd_tee_gateway=debug
MAX_REQUEST_BYTES=1048576
ADMIN_TOKEN=
CORS_ALLOWED_ORIGIN=

RECEIPT_TTL_SECS=3600
RECEIPT_MAX_ENTRIES=10000
WORKLOAD_SUBJECT=clawd-tee-gateway
SOURCE_REPO_URL=https://github.com/Solizardking/clawd-tee
