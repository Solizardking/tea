# Model ids for clients — clawd-tee-gateway proxies whatever the upstream accepts.
# Primary upstream is set in .env (UPSTREAM_URL / UPSTREAM_API_KEY).

# --- Redpill (when UPSTREAM_URL=https://api.redpill.ai) ---
REDPILL_MODEL1=nvidia/nemotron-3.5-lightning
REDPILL_MODEL2=z-ai/glm-5.3
REDPILL_MODEL3=qwen/qwen3.8-27b
REDPILL_MODEL4=meta/muse-glimmer-30b
REDPILL_MODEL5=deepseek/deepseek-v4-flash-0731
REDPILL_MODEL6=z-ai/glm-5.3-flash

# --- OpenRouter (when UPSTREAM_URL=https://openrouter.ai/api) ---
OPENROUTER_MODEL=qwen/qwen3.8-27b
OPENROUTER_FREEMODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FREE_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FREE_MODEL1=poolside/laguna-s-2.1:free
OPENROUTER_FREE_MODEL2=poolside/laguna-m.1:free
OPENROUTER_FREE_MODEL4=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FREE_MODEL5=cohere/north-mini-code:free
OPENROUTER_FREE_MODEL6=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FREE1=inclusionai/ling-3.0-flash-vl:free
OPENROUTER_FREE2=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FREE3=poolside/laguna-s-2.1:free
OPENROUTER_FREE4=inclusionai
OPENROUTER_DEEPSEEK=deepseek/deepseek-v4.1-flash
OPENROUTER_DEEP=deepseek/deepseek-v3.2
OPENROUTER_GROK=x-ai/grok-4.1-fast
OPENROUTER_KIMILATEST=~moonshotai/kimi-latest
OPENROUTER_MUSE1=meta/muse-voice-transcribe-1.0
OPENROUTER_MUSE2=meta/muse-spark-1.3-contributor
OPENROUTER_ASTRA1=~openai/gpt-astra-latest
OPENROUTER_SOL=~openai/gpt-sol-latest
OPENROUTER_TERRA=~openai/gpt-terra-latest
OPENROUTER_LUNA=~openai/gpt-luna-latest
OPENROUTER_SAKANA_FUGU_ULTRA=sakana/fugu-ultra-v2
OPENROUTER_VIDEO_EDIT=black-forest-labs/flux-video-edit
OPENROUTER_IMAGE1=openai/gpt-image-2.5-sunburst
OPENROUTER_IMAGE2=openai/gpt-image-2.5-flare

# --- xAI (needs separate routes / second upstream; not wired in gateway yet) ---
# XAI_API_KEY=<set via secrets>
# XAI_VOICE=grok-4.6-voice
# XAI_IMAGE=grok-imagine
# XAI_VIDEO=grok-video
