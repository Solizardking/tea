# Clawd Kora operator + x402 facilitator
# Copy to .env (gitignored) and fill in secrets.
# Generate a signer: solana-keygen new --no-bip39-passphrase --outfile /tmp/kora-signer.json
# Then encode the 64-byte JSON array as base58 for KORA_SIGNER_PRIVATE_KEY.

# Base58 64-byte Solana secret key (never commit the real value)
KORA_SIGNER_PRIVATE_KEY=

# Public key of the signer above — also used as x402 PAY_TO / extra.feePayer
KORA_SIGNER_ADDRESS=4utbbZp1KzxNDeZj2FMFyyUKg4jeTjNvgtxsRAGQMUWw

# Must match [kora.auth] api_key in kora.toml
KORA_API_KEY=kora_facilitator_api_key_example

# Solana RPC used by `kora rpc start` (devnet default; local validator: http://127.0.0.1:8899)
RPC_URL=https://api.devnet.solana.com

KORA_RPC_URL=http://127.0.0.1:8080
KORA_PORT=8080

# x402 facilitator
FACILITATOR_PORT=3000
# x402 v1 clients use solana-devnet; CAIP-2 solana:<genesis> is also accepted
NETWORK=solana-devnet

# $CLAWD pump mint — must stay in kora.toml allowed_spl_paid_tokens
CLAWD_MINT=8cHzQHUS2s2h8TzCmfqPKYiM4dSt4roa3n7MyRLApump
